  "sources": [
    {
      "id": "f01",
      "title": "渡口与钥匙",
      "split": "development",
      "text": "黄昏时，我把旧钥匙交给了摆渡人，他把它挂在桥边。等我回来时，渡口已变成了菜园，只有那把钥匙还悬在树上。"
    },
    {
      "id": "f02",
      "title": "屋里的钟",
      "split": "development",
      "text": "父亲把坏钟埋进屋后的土里，说它该歇一歇了。第二年那里长出一株向日葵，花盘始终朝着卧室的窗户。"
    },
    {
      "id": "f03",
      "title": "榆树的门牌",
      "split": "development",
      "text": "村里拆房时，母亲把旧门牌钉在榆树上。每年冬天，她仍到树下等邮差，终于等来一封写着树叶名字的信。"
    },
    {
      "id": "f04",
      "title": "狗与井盖",
      "split": "development",
      "text": "那条白狗每天把耳朵贴在旧井盖上，听主人多年前落下的一枚铜钱。大雨后井水涨起来，狗却把叫声留在了干燥的碗里。"
    },
    {
      "id": "f05",
      "title": "牛与针",
      "split": "development",
      "text": "奶奶把断针藏在牛铃里，怕针还想缝一件衣服。秋天卖牛以后，铃铛留在门上，每次响起来，屋里的旧棉袄就抖一下。"
    },
    {
      "id": "f06",
      "title": "电影院的票",
      "split": "development",
      "text": "电影散场后，售票员把最后一张票折成小船，放进放映室漏下的雨水。第二天屏幕上只剩一条河，观众都坐在河岸上。"
    },
    {
      "id": "f07",
      "title": "地铁里的瓶子",
      "split": "holdout",
      "text": "清洁工在末班地铁捡到一只装着海水的瓶子，把它放在广播旁。后来每到终点，列车便轻轻晃动，像一条不肯靠岸的船。"
    },
    {
      "id": "f08",
      "title": "医院的纸鹤",
      "split": "holdout",
      "text": "孩子把病历折成纸鹤，挂在走廊尽头的暖气上。春天医生打开窗，那些纸鸟没有飞出去，只把床号带到了窗外的杏树上。"
    },
    {
      "id": "f09",
      "title": "面包与收据",
      "split": "holdout",
      "text": "面包师把欠账收据揉进面团，让那些数字在炉里膨胀。清晨老人买走最轻的一块面包，说昨天欠下的风终于还清了。"
    },
    {
      "id": "f10",
      "title": "港口的煤灯",
      "split": "holdout",
      "text": "守灯人把父亲的煤灯放进废弃的救生圈，推向无人的港湾。多年后潮水送回一圈暖光，岸上的石头终于认出了自己的影子。"
    },
    {
      "id": "f11",
      "title": "屋顶的收音机",
      "split": "holdout",
      "text": "外公把收音机埋在屋顶的雪里，说北方的声音需要冷一点。雪融以后，天线开出一朵铁花，整个夏天只播报蜜蜂经过的消息。"
    },
    {
      "id": "f12",
      "title": "幼儿园的雨鞋",
      "split": "holdout",
      "text": "老师把孩子遗忘的雨鞋摆在沙坑旁，给每双鞋装上一勺月光。毕业那晚，沙子长成小路，鞋子独自走回了不同的家。"
    }
  ],
