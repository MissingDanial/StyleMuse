# ===== 大语言模型配置 =====
# provider 类型: openai（OpenAI 兼容聊天接口）或 anthropic
LLM_PROVIDER=openai

# 模型名称，以服务商和账户实际可用列表为准
LLM_MODEL=deepseek-flash

# API 地址（OpenAI 官方可留空）
LLM_BASE_URL=https://api.deepseek.com/v1

# API 密钥
LLM_API_KEY=your_api_key_here

# ===== Embedding 模型配置 =====
# provider 类型: dashscope（千问）、openai（兼容接口）或 local（本地 BGE）
EMBEDDING_PROVIDER=local

# Embedding 模型名称
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 本地嵌入无需 API 密钥
EMBEDDING_API_KEY=

# OpenAI 兼容 Embedding 服务地址（DashScope 模式可留空）
EMBEDDING_BASE_URL=

# 先安装 requirements-local-embeddings.lock，再运行：
# python scripts/setup_local_embeddings.py --download --configure
# 云端嵌入可改用 dashscope 或 openai，并填写该嵌入服务的独立密钥。
EMBEDDING_CACHE_DIR=.stylemuse/models
# 初始化完成后只读本地模型文件，不在普通生成请求中下载模型
EMBEDDING_LOCAL_ONLY=1

# 共享或 Docker 部署必填；本机直接运行可留空
# 请使用随机生成的长密码，不要复用模型 API Key
STYLEMUSE_ACCESS_TOKEN=
# HTTPS 反向代理部署时设为 1
STYLEMUSE_HTTPS=0
# 默认关闭正文和 Prompt 预览日志；排查问题时可临时开启
STYLEMUSE_LOG_PREVIEWS=0

# 默认在 Web 进程中启动后台任务线程；独立运行 scripts/worker.py 时设为 1
STYLEMUSE_EXTERNAL_WORKER=0
