# Python runtimes, dependency caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.uv-cache/
.cache/
build/
dist/

# Test, coverage and type-checker artifacts
.pytest_cache/
.pytest_tmp*/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Credentials: publish the template, never the local configuration
.env
.env.*
!.env.example
env_test*.txt

# Application state, downloaded models, evaluations and temporary exports
/.stylemuse/
/.tmp/
/logs/
*.log
*.log.*
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.tmp
*.bak

# Private author workspaces are local by default.
# Keep only the four public, bundled demonstration files.
/authors/*
!/authors/liu_liangcheng/
/authors/liu_liangcheng/*
!/authors/liu_liangcheng/config.json
!/authors/liu_liangcheng/style_guide.md
!/authors/liu_liangcheng/few_shot.md
!/authors/liu_liangcheng/works/
/authors/liu_liangcheng/works/*
!/authors/liu_liangcheng/works/刘亮程文章汇总.txt

# Legacy runtime data and source books
/data/embeddings/
/data/chunks/
/epub_data/
*.epub

# Editor, assistant and operating-system files
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
Desktop.ini
